# Discord application (Developer Portal -> your app). The client ID is public and is bundled into the page.
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only needed for the /plot slash command (register it with `npm run register`).
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
# Optional: natural-language prompts. Typed math works without it.
ANTHROPIC_API_KEY=
PLOTBOT_MODEL=claude-opus-5-5
# Saved plots (formula, parameter values, ranges, IDs; no images) and how long they are kept.
PLOTBOT_DB=plotbot-activity.sqlite3
PLOTBOT_RETENTION_DAYS=30
PORT=3001
