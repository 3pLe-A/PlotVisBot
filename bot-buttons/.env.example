# Discord bot token (Developer Portal -> your application -> Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=
# Optional: enables natural-language prompts ("a damped oscillator..."). Typed math works without it.
ANTHROPIC_API_KEY=
# Claude model used to rewrite natural language as math.
PLOTBOT_MODEL=claude-opus-5-5
# Optional: a server ID for instant slash-command updates while testing (global sync can take up to an hour).
DEV_GUILD_ID=
# SQLite file with plot state (formula, parameter values, IDs; no images) and how long rows are kept.
PLOTBOT_DB=plotbot.sqlite3
PLOTBOT_RETENTION_DAYS=30
# 1 = only the author of a plot can press its buttons.
PLOTBOT_OWNER_ONLY=0
# Parallel render processes and per-render time limit in seconds.
PLOTBOT_RENDER_WORKERS=2
PLOTBOT_RENDER_TIMEOUT=30
# 1 = /tex uses a real LaTeX installation (TeX Live with T2A/babel-russian) instead of Matplotlib mathtext.
PLOTBOT_USETEX=0
