{
  "name": "plotbot-activity",
  "version": "0.1.0",
  "private": true,
  "description": "Discord Activity that plots formulas with live parameter sliders and 3D rotation",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "register": "node scripts/register-commands.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@discord/embedded-app-sdk": "2.5.0",
    "discord-interactions": "4.4.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "katex": "0.19.0",
    "mathjs": "15.2.0",
    "plotly.js-dist-min": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "vite": "8.3.4"
  }
}
